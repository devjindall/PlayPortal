{
  "name": "playportal",
  "version": "1.0.0",
  "description": "PlayPortal - Web-based HTML5 Gaming Platform",
  "private": true,
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "test:server": "npm --prefix server run test",
    "seed": "npm --prefix server run seed",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node server/src/server.js",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "playportal",
    "gaming-platform",
    "mern"
  ],
  "author": "",
  "license": "ISC"
}
